{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "REPLACE_WITH_NEW_WORKERS_NAME",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "triggers": { "crons": ["0 18 * * 7"] },
  "d1_databases": [{ "binding": "DB", "database_name": "REPLACE_WITH_NEW_D1_NAME", "database_id": "REPLACE_WITH_NEW_D1_ID", "migrations_dir": "./drizzle-production" }],
  "r2_buckets": [{ "binding": "SIGNATURES", "bucket_name": "REPLACE_WITH_PRIVATE_R2_BUCKET" }, { "binding": "SERVICE_PHOTOS", "bucket_name": "REPLACE_WITH_PRIVATE_R2_BUCKET" }],
  "vars": {
    "APP_ORIGIN": "https://REPLACE_WITH_NEW_SUBDOMAIN.workers.dev",
    "SMTP_USER": "jerry.master.claw@gmail.com",
    "TURNSTILE_SITE_KEY": "REPLACE_WITH_TURNSTILE_SITE_KEY"
  }
}
